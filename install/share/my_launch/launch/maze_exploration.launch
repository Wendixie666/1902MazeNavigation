<launch>
  <arg name="model" default="waffle" doc="model type [waffle, waffle_pi, burger]"/>
  <arg name="dynamic_obstacles" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>

  <include file="$(find my_launch)/turtlebot3_empty_world.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="dynamic_obstacles" value="$(arg dynamic_obstacles)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
  </include>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <rosparam file="$(find my_launch)/config/gmapping.yaml" command="load"/>
    <remap from="scan" to="/scan"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base" output="screen" respawn="false">
    <rosparam file="$(find my_launch)/config/costmap_common.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find my_launch)/config/costmap_common.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find my_launch)/config/global_costmap.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find my_launch)/config/local_costmap.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find my_launch)/config/move_base.yaml" command="load"/>
    <remap from="cmd_vel" to="/cmd_vel"/>
    <remap from="odom" to="/odom"/>
  </node>

  <node pkg="explore_lite" type="explore" name="explore" output="screen" respawn="false">
    <param name="robot_base_frame" value="base_footprint"/>
    <param name="costmap_topic" value="/move_base/global_costmap/costmap"/>
    <param name="costmap_updates_topic" value="/move_base/global_costmap/costmap_updates"/>
    <param name="visualize" value="true"/>
    <param name="planner_frequency" value="0.33"/>
    <param name="progress_timeout" value="30.0"/>
    <param name="potential_scale" value="3.0"/>
    <param name="orientation_scale" value="0.0"/>
    <param name="gain_scale" value="1.0"/>
    <param name="transform_tolerance" value="0.5"/>
    <param name="min_frontier_size" value="0.5"/>
  </node>

  <node pkg="my_maze_world" type="green_goal_detector.py" name="green_goal_detector" output="screen">
    <param name="image_topic" value="/camera/rgb/image_raw"/>
    <param name="min_area" value="500"/>
    <param name="required_frames" value="5"/>
  </node>
</launch>
