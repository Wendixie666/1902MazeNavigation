<?xml version="1.0" ?>
<sdf version="1.6">
<world name="maze_world">

  <!-- Layout values: maze_scale=0.5 in x/y; wall_thickness=0.5 m. -->

  <include>
    <uri>model://sun</uri>
  </include>

  <include>
    <uri>model://ground_plane</uri>
  </include>

  <!-- 外围墙 -->

  <!-- 北墙分为两段，中心在 x=4 处留出小缺口（入口） -->
  <model name="wall_north_left">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>8.75 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8.75 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-0.625 5 0.5 0 0 0</pose>
  </model>

  <model name="wall_north_right">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.75 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.75 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>4.625 5 0.5 0 0 0</pose>
  </model>

  <!-- 南墙在 x=-4 处留出缺口（入口） -->
  <model name="wall_south_left">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.75 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.75 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-4.625 -5 0.5 0 0 0</pose>
  </model>

  <model name="wall_south_right">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>8.75 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>8.75 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>0.625 -5 0.5 0 0 0</pose>
  </model>

  <!-- 东墙分段，y=4 处留缺口（与北墙的缺口在同一对角） -->
  <model name="wall_east_bottom">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 8.75 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 8.75 1</size></box></geometry>
      </visual>
    </link>
    <pose>5 -0.625 0.5 0 0 0</pose>
  </model>

  <model name="wall_east_top">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 0.75 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 0.75 1</size></box></geometry>
      </visual>
    </link>
    <pose>5 4.625 0.5 0 0 0</pose>
  </model>

  <!-- 西墙分段，y=-4 处留缺口（与南墙的缺口在同一对角） -->
  <model name="wall_west_bottom">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 0.75 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 0.75 1</size></box></geometry>
      </visual>
    </link>
    <pose>-5 -4.625 0.5 0 0 0</pose>
  </model>

  <model name="wall_west_top">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 8.75 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 8.75 1</size></box></geometry>
      </visual>
    </link>
    <pose>-5 0.625 0.5 0 0 0</pose>
  </model>


  <!-- 内部迷宫墙 -->

  <model name="maze_wall1">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>4 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>4 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-2 -2.5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 4 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 4 1</size></box></geometry>
      </visual>
    </link>
    <pose>1 -0.5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall3">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>4 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>4 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>2 1.5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall4">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 4 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 4 1</size></box></geometry>
      </visual>
    </link>
    <pose>-1.5 2.5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall5">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>3 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>3 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-3 0.5 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall6">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 3 1</size></box></geometry>
      </visual>
    </link>
    <pose>3 -2 0.5 0 0 0</pose>
  </model>


  <model name="maze_wall7">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2.5 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2.5 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>0.5 3.5 0.5 0 0 0</pose>
  </model>

  <!-- 新增内部墙以增加复杂度 -->
  <model name="maze_wall8">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 3 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 3 1</size></box></geometry>
      </visual>
    </link>
    <pose>0 2 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall9">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>2 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-1 1 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall10">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.5 2.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 2.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>1.5 -1 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall11">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.5 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.5 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>-2.5 -1.5 0.5 0 0 0</pose>
  </model>

  <model name="maze_wall12">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1 0.5 1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1 0.5 1</size></box></geometry>
      </visual>
    </link>
    <pose>3 3 0.5 0 0 0</pose>
  </model>

  <!-- Green visual goal: placed in the southwest corner opposite the robot spawn. -->
  <model name="green_goal">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box><size>0.35 0.35 0.35</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.35 0.35 0.35</size></box></geometry>
        <material>
          <ambient>0.05 0.9 0.05 1</ambient>
          <diffuse>0.05 0.9 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <pose>-4.0 -4.5 0.175 0 0 0</pose>
  </model>

  <!-- Dynamic obstacles placeholders: created so controllers can update their ModelState -->
  <model name="dynamic_obstacle_1">
    <link name="link">
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    <pose>-4 -3 0.3 0 0 0</pose>
  </model>

  <model name="dynamic_obstacle_2">
    <link name="link">
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.45 0.05 1</ambient>
          <diffuse>0.8 0.45 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <pose>2.5 -4 0.3 0 0 0</pose>
  </model>

  <model name="dynamic_obstacle_3">
    <link name="link">
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>
    <pose>3.4 4 0.3 0 0 0</pose>
  </model>

</world>
</sdf>
